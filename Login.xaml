<Window x:Class="FreePOS.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="Start System" Height="520" Width="900" Background="Transparent" AllowsTransparency="True" WindowStyle="None" WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- Outer rounded card to emulate tablet frame -->
        <Border CornerRadius="16" Background="#FFF7F9FB" Padding="18" Margin="12" Effect="{DynamicResource DropShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Branding + Login card -->
                <StackPanel Grid.Column="0" Margin="24">
                    <TextBlock Text="Expresale" FontSize="26" FontWeight="Bold" Foreground="#222" />
                    <TextBlock Text="" Foreground="#666" />

                    <!-- white login card -->
                    <Border Background="White" CornerRadius="8" Padding="20" Width="360">
                        <Border.Effect>
                            <DropShadowEffect Color="#33000000" BlurRadius="12" ShadowDepth="2" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Login" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                            <TextBox x:Name="tb_Name" Height="36" Margin="0,6,0,6" Padding="8" FontSize="14" />
                            <PasswordBox x:Name="tb_Pasword" Height="36" Margin="0,6,0,6" Padding="8" FontSize="14" KeyDown="PressEnter" />

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,12">
                              
                                <TextBlock Text="" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#666" />
                            </StackPanel>

                            <Button Click="btn_Login" Content="Log in" Height="40" Background="#2D84FF" Foreground="White" FontWeight="Bold" BorderThickness="0" />

                            <StackPanel Orientation="Vertical" Margin="0,12,0,0" HorizontalAlignment="Center">
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: illustration-style shapes -->
                <Grid Grid.Column="1">
                    <Canvas>

                       

                        <Image Source="/FreePOS;component/assets/marketplace.png" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="10" Width="400"></Image>

                    </Canvas>
                </Grid>
            </Grid>
        </Border>

        <!-- Resources -->
        <Grid.Resources>
            <DropShadowEffect x:Key="DropShadow" Color="#40000000" BlurRadius="18" ShadowDepth="4" />
        </Grid.Resources>
    </Grid>

</Window>
